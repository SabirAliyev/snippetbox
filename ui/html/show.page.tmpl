{{template "base" .}}

{{define "title"}}Snippet #{{.Snippet.ID}}{{end}}

{{define "main"}}
    {{with .Snippet}}
    <div class='snippet'>
        <div class='metadata'>
            <strong>{{.Title}}</strong>
            <span>#{{.ID}}</span>
        </div>
        <pre><code>{{.Content}}</code></pre>
        <div class='metadata'>
            <!-- Use the new template function here. -->
            <title>Created: {{humanDate .Created}}</title>
            <title>Expires: {{humanDate .Expires}}</title>
        </div>
    </div>
    {{end}}
{{end}}


